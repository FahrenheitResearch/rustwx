RUSTWX_VERSION=0.4.4
API_HOST=weather-api.example.com

# Local service paths inside the container.
ARTIFACT_ROOT=/data/artifacts
RUSTWX_CACHE_DIR=/data/cache
RUSTWX_GLM_DIR=/data/glm

# Host paths mounted into the containers. Put these on a large volume if you add one.
HOST_CACHE_DIR=./data/cache
HOST_ARTIFACT_DIR=./data/artifacts
HOST_GLM_DIR=./data/glm
HOST_VOLUME_STORE_DIR=./data/volume-stores
HOST_RUSTWX_BIN_DIR=./bin

# API behavior.
SERVICE_API_KEY=
PUBLIC_SITE_ENABLED=true
ALLOW_OUTSIDE_CALIFORNIA=false
DEFAULT_MODEL=hrrr
DEFAULT_SOURCE=nomads
DEFAULT_DOMAIN=california
DEFAULT_PRODUCTS=2m_temperature_10m_winds,2m_relative_humidity_10m_winds,2m_dewpoint_10m_winds,10m_wind_gusts,vpd_2m,fire_weather_composite,qpf_1h,10m_wind_1h_max,2m_temp_0_24h_range,2m_temp_24_48h_range,2m_temp_0_48h_range,visibility,smoke_pm25_native,smoke_column
DEFAULT_FORECAST_HOURS=0-48
DEFAULT_WIDTH=1400
DEFAULT_HEIGHT=1600
FULL_RUN_MIN_AGE_HOURS=6

# Keeps the latest 00/06/12/18Z HRRR run with f048 available warmed for click meteograms.
METEOGRAM_WARM_ENABLED=true
METEOGRAM_WARM_IN_API=false
METEOGRAM_WARM_INTERVAL_SEC=900
METEOGRAM_WARM_CHUNK_SIZE=6
METEOGRAM_WARM_HOURS=0-48
METEOGRAM_WARM_LAT=37.25
METEOGRAM_WARM_LON=-119.5
METEOGRAM_WARM_STATUS_PATH=/data/artifacts/meteogram_warm_status.json
# Blank means rustwx's full default meteogram variable set.
METEOGRAM_WARM_VARIABLES=
METEOGRAM_SAMPLE_WORKERS=4
METEOGRAM_SAMPLE_CHUNK_SIZE=7

# Keeps a CA-only in-process Rust grid store in the API for fast arbitrary-point meteograms.
FAST_METEOGRAM_STORE_ENABLED=true
FAST_METEOGRAM_STORE_INTERVAL_SEC=900
FAST_METEOGRAM_STORE_BOUNDS=-125.2,-113.5,31.0,43.0

# HRRR CA pressure VolumeStore sidecar and rendered cross-section artifact lane.
# Mount release binaries in HOST_RUSTWX_BIN_DIR:
#   volume_store_dashboard
#   volume_store_cross_section_render
PRESSURE_VOLUME_ENABLED=true
PRESSURE_VOLUME_BASE_URL=http://pressure-volume:8797
PRESSURE_VOLUME_TIMEOUT_SEC=20
PRESSURE_VOLUME_STORE_PATH=/data/volume-stores/current
PRESSURE_VOLUME_PARTIAL_STORE_PATH=/data/volume-stores/latest-partial
PRESSURE_VOLUME_RENDERER_PATH=/app/bin/volume_store_cross_section_render
PRESSURE_CROSS_SECTION_STYLE_VERSION=cross_section_plot_v2
PRESSURE_CROSS_SECTION_RENDER_MAX_ACTIVE=3
PRESSURE_CROSS_SECTION_LOOP_MAX_ACTIVE=2
PRESSURE_CROSS_SECTION_RENDER_TIMEOUT_SEC=180
PRESSURE_CROSS_SECTION_LOOP_TIMEOUT_SEC=900
PRESSURE_CROSS_SECTION_DEFAULT_TOP_HPA=100
PRESSURE_CROSS_SECTION_DEFAULT_WIDTH=1400
PRESSURE_CROSS_SECTION_DEFAULT_HEIGHT=820
PRESSURE_CROSS_SECTION_MIN_SPACING_KM=1
PRESSURE_CROSS_SECTION_MAX_SPACING_KM=80
PRESSURE_VOLUME_BUILDER_ENABLED=true
PRESSURE_VOLUME_BUILDER_INTERVAL_SEC=900
PRESSURE_VOLUME_BUILDER_PATH=/app/bin/hrrr_pressure_volume_store
PRESSURE_VOLUME_BUILDER_STORE_ROOT=/data/volume-stores
PRESSURE_VOLUME_BUILDER_STATUS_PATH=/data/volume-stores/builder_status.json
PRESSURE_VOLUME_BUILDER_LOAD_PARALLELISM=4
PRESSURE_VOLUME_BUILDER_KEEP_COMPLETED=2
PRESSURE_VOLUME_BUILDER_REQUIRE_STATIC_MANIFEST=true
PRESSURE_VOLUME_PARTIAL_ENABLED=true
PRESSURE_VOLUME_PARTIAL_REQUIRE_STATIC_MANIFEST=true
PRESSURE_VOLUME_PARTIAL_MAX_HOUR=18
PRESSURE_VOLUME_BUILDER_START_HOUR=0
PRESSURE_VOLUME_BUILDER_END_HOUR=48
PRESSURE_VOLUME_BUILDER_BOUNDS=-125.2,-113.5,31.0,43.0

# GOES-West GLM lightning overlay lane. The lightning worker fetches recent LCFA
# files, renders a California lightning map, and publishes PNG/WebP + manifest.
LIGHTNING_ENABLED=true
LIGHTNING_INTERVAL_SEC=30
LIGHTNING_DOMAIN=california
LIGHTNING_LABEL=California GLM Lightning
LIGHTNING_SATELLITE=goes18
LIGHTNING_FETCH_COUNT=90
LIGHTNING_LOOKBACK_HOURS=3
LIGHTNING_MAX_AGE_MIN=30
LIGHTNING_WIDTH=1400
LIGHTNING_HEIGHT=1100

# GOES-West ABI/GLM satellite lane. Raw NetCDF files are cached under
# RUSTWX_CACHE_DIR/satellite; artifacts publish under satellite/latest.json.
SATELLITE_ENABLED=true
SATELLITE_INTERVAL_SEC=300
SATELLITE_DOMAIN=pacific_southwest
SATELLITE_LABEL=Pacific Southwest Satellite
SATELLITE_SATELLITE=goes18
SATELLITE_ABI_PRODUCT=ABI-L2-CMIPC
SATELLITE_PRODUCTS=goes_geocolor,goes_glm_fed_geocolor,goes_airmass_rgb,goes_sandwich_rgb,goes_day_night_cloud_micro_combo_rgb,goes_fire_temperature_rgb,goes_dust_rgb,goes_abi_band_01,goes_abi_band_02,goes_abi_band_03,goes_abi_band_04,goes_abi_band_05,goes_abi_band_06,goes_abi_band_07,goes_abi_band_08,goes_abi_band_09,goes_abi_band_10,goes_abi_band_11,goes_abi_band_12,goes_abi_band_13,goes_abi_band_14,goes_abi_band_15,goes_abi_band_16
SATELLITE_SCAN_LOOKBACK_HOURS=6
SATELLITE_DISCOVERY_RETRIES=2
SATELLITE_RETRY_SLEEP_MS=20000
SATELLITE_DOWNLOAD_GLM=true
SATELLITE_GLM_FETCH_COUNT=90
SATELLITE_GLM_LOOKBACK_HOURS=3
SATELLITE_GLM_MAX_AGE_MIN=30
SATELLITE_WIDTH=1400
SATELLITE_HEIGHT=1100
SATELLITE_STILL_WIDTHS=600
SATELLITE_STILL_FORMATS=webp
SATELLITE_STILL_ALLOW_UPSCALE=false
SATELLITE_LOOP_ENABLED=true
SATELLITE_LOOP_DURATIONS_MIN=30
SATELLITE_LOOP_WIDTHS=600
SATELLITE_LOOP_FORMATS=webp
SATELLITE_LOOP_GIF_MAX_DURATION_MIN=0
SATELLITE_LOOP_MAX_FRAMES=6
SATELLITE_LOOP_FRAME_MS=450

# Local rustwx GRIB/field cache safety valve. The static worker runs this periodically.
CACHE_CLEANUP_ENABLED=true
CACHE_CLEANUP_INTERVAL_SEC=1800
CACHE_CLEANUP_MAX_AGE_HOURS=30
CACHE_CLEANUP_MAX_CACHE_GB=200
CACHE_CLEANUP_TARGET_CACHE_GB=185
CACHE_CLEANUP_MIN_FREE_GB=160
CACHE_CLEANUP_TARGET_FREE_GB=220
CACHE_CLEANUP_EMERGENCY_MIN_AGE_HOURS=4

# Long-running static map worker. It keeps all configured PNGs and updates hrrr/latest.json.
STATIC_MAP_WORKER_ENABLED=true
STATIC_MAP_WORKER_INTERVAL_SEC=30
STATIC_MAP_WORKER_PARALLELISM=3
STATIC_MAP_WORKER_CYCLE_LOOKBACK_HOURS=8
STATIC_MAP_BACKFILL_BATCH_HOURS=3
STATIC_MAP_SMOKE_INTERVAL_HOURS=1
STATIC_MAP_BRAND_TEXT=California Wildfire Tracking
STATIC_MAP_WEBP_ENABLED=true
STATIC_MAP_WEBP_QUALITY=72

# Cloudflare R2. Leave blank for local-only dry runs.
R2_ACCOUNT_ID=de348a5190a7a5676bd2f6f19d506eec
R2_BUCKET=cafire
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://de348a5190a7a5676bd2f6f19d506eec.r2.cloudflarestorage.com
PUBLIC_ARTIFACT_BASE_URL=https://pub-8665dc80b0aa4f1d8a3e91eda3a5c01f.r2.dev
